# MediKiosk Global Environment Variables

# Django Security
SECRET_KEY=django-insecure-medikiosk-core-secret-key-2026-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,frontend

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=medikiosk_db
DB_USER=medikiosk_user
DB_PASSWORD=medikiosk_secret
DB_HOST=localhost
DB_PORT=5432
USE_SQLITE=False

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SimpleJWT Authentication
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Optional LLM API Integration (Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Settings
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
