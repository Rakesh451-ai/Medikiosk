# MediKiosk Backend Environment Variables Template

# Security
SECRET_KEY=your-secure-production-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Demo Mode Flag (MUST be False in production)
# When False, all fallback passwords (e.g. 123456, PatientPass123!) are strictly disabled
DEMO_MODE=False

# CORS Configuration
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# OCR & Tesseract path (optional if default in system PATH)
# TESSERACT_CMD=/usr/bin/tesseract

# AI Assistant Configuration (Groq / OpenAI compatible API)
AI_API_KEY=your-ai-api-key-here
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
