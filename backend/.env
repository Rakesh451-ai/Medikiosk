# ==============================================================================
# 🔑 PASTE YOUR LLM API KEY BELOW:
# You can paste your Google Gemini API Key (recommended) or OpenAI API Key
# ==============================================================================
LLM_API_KEY=your_api_key_here

# LLM Provider: 'gemini' (default, free & fast) or 'openai' or 'groq'
LLM_PROVIDER=gemini

# Model name:
# For Gemini: 'gemini-1.5-flash', 'gemini-2.0-flash', or 'gemini-1.5-pro'
# For OpenAI: 'gpt-4o-mini' or 'gpt-4o'
LLM_MODEL=gemini-1.5-flash
